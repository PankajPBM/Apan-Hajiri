<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\E.Attendance.Core\E.Attendance.Core.csproj" />
    <ProjectReference Include="..\E.Attendance.Data\E.Attendance.Data.csproj" />
    <ProjectReference Include="..\E.Attendance.Services\E.Attendance.Services.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\icon\E_Att.ico</ApplicationIcon>
    <FrontendExportDir>..\e-attendance-next\out</FrontendExportDir>
    <!-- Ship only English satellite resources (no cs/de/fr/ja/... waste folders) -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.1.16</Version>
    <FileVersion>1.1.16.0</FileVersion>
    <AssemblyVersion>1.1.16.0</AssemblyVersion>
    <Company>PB Tech Zone</Company>
    <Authors>PB Tech Zone</Authors>
    <Product>Apan Hajiri</Product>
    <Description>Apan Hajiri - Enterprise Biometric API &amp; Web Service</Description>
    <Copyright>Copyright © 2026 PB Tech Zone. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
    <Content Update="appsettings*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target Name="BuildFrontendBeforeCompile" BeforeTargets="BeforeBuild">
    <Message Importance="High" Text="[Frontend Build] Installing dependencies and building Next.js static export..." />
    <Exec Command="npm install &amp;&amp; npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\e-attendance-next" ConsoleToMSBuild="true" />
  </Target>

  <Target Name="SyncBundledFrontend" AfterTargets="Build;Publish" Condition="Exists('$(MSBuildProjectDirectory)\$(FrontendExportDir)\index.html')">
    <ItemGroup>
      <BundledFrontendFiles Include="$(MSBuildProjectDirectory)\$(FrontendExportDir)\**\*" />
    </ItemGroup>

    <Message Importance="High" Text="Syncing bundled frontend from $(FrontendExportDir) to wwwroot and output directory." />

    <!-- Clean old stale static chunks in wwwroot before syncing new build -->
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot\_next" Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\_next')" />
    <RemoveDir Directories="$(TargetDir)\wwwroot\_next" Condition="'$(TargetDir)' != '' And Exists('$(TargetDir)\wwwroot\_next')" />

    <!-- Sync to source wwwroot for persistence -->
    <Copy SourceFiles="@(BundledFrontendFiles)" DestinationFiles="@(BundledFrontendFiles->'$(MSBuildProjectDirectory)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />

    <!-- Sync to output directory for immediate use by the running app -->
    <Copy SourceFiles="@(BundledFrontendFiles)" DestinationFiles="@(BundledFrontendFiles->'$(TargetDir)\wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="'$(TargetDir)' != ''" />
  </Target>

</Project>
